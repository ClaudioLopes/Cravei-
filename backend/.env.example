DATABASE_URL="postgresql://bolao:bolao@localhost:5432/bolao?schema=public"

PORT=3000

JWT_ACCESS_SECRET="troque-este-segredo-de-acesso"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# Token grátis de football-data.org (cadastre-se em https://www.football-data.org/client/register)
FOOTBALL_DATA_API_TOKEN=""

# Código da competição na football-data.org (BSA = Campeonato Brasileiro Série A)
FOOTBALL_DATA_COMPETITION="BSA"

# Expressão cron para sincronização de jogos (padrão: a cada 5 minutos)
FIXTURES_SYNC_CRON="*/5 * * * *"

# Dias de diferença acima dos quais um jogo remarcado ganha prazo individual de palpite
RESCHEDULE_THRESHOLD_DAYS=3

# Minutos de antecedência para a notificação de fechamento da rodada
NOTIFICATION_LEAD_MINUTES=15
